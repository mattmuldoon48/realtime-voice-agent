# Non-secret application settings
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=realtime-voice-agent

# Use the AWS credential provider chain. Prefer a dedicated local profile.
# Never put AWS access keys, secret keys, session tokens, or bearer tokens here.
AWS_PROFILE=
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=matthew
NOVA_INPUT_SAMPLE_RATE=16000
NOVA_OUTPUT_SAMPLE_RATE=24000
NOVA_CHANNELS=1
NOVA_SAMPLE_WIDTH_BYTES=2
NOVA_AUDIO_CHUNK_FRAMES=512
NOVA_SESSION_ROTATION_SECONDS=240

# Primary Account SID and Auth Token authenticate both Twilio entry points.
# Values remain deliberately blank in this tracked template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true

# Replace only in ignored local .env after starting ngrok. The media URL is the exact canonical
# WSS URL used for both TwiML and WebSocket signature validation; do not add a trailing slash.
PUBLIC_BASE_URL=
PUBLIC_MEDIA_WS_URL=

# Inbound-only public portfolio demo. Persona IDs resolve through the versioned persona store.
DEMO_MODE_ENABLED=true
DEMO_PERSONA_CHOICES=1:care-coordinator,2:financial-services-assistant,3:travel-concierge,4:history-guide
DEMO_MAX_CALL_DURATION_SECONDS=300
DEMO_RATE_LIMIT_MAX_CALLS=3
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600
DEMO_GLOBAL_CONCURRENCY_LIMIT=2
DEMO_BUDGET_MAX_CALLS=50
DEMO_BUDGET_WINDOW_SECONDS=86400
DEMO_RESERVATION_TTL_SECONDS=30
DEMO_PERSIST_TRANSCRIPTS=false

# DynamoDB resource names are non-secret.
PERSONAS_TABLE=RealtimeVoiceAgentPersonas
SESSIONS_TABLE=RealtimeVoiceAgentSessions
TRANSCRIPTS_TABLE=RealtimeVoiceAgentTranscriptTurns
TRANSCRIPT_RETENTION_DAYS=7
STORE_PHONE_NUMBERS=false

# CloudWatch publishing is opt-in; stdout JSON remains enabled when this is false.
CLOUDWATCH_ENABLED=false
CLOUDWATCH_LOG_GROUP=/realtime-voice-agent/application
CLOUDWATCH_LOG_STREAM=local
CLOUDWATCH_METRIC_NAMESPACE=RealtimeVoiceAgent/VoiceAgent
TELEMETRY_QUEUE_MAX_EVENTS=1000
TELEMETRY_BATCH_MAX_ITEMS=100
TELEMETRY_FLUSH_INTERVAL_SECONDS=1
TELEMETRY_MAX_ATTEMPTS=2
TELEMETRY_CLEANUP_TIMEOUT_SECONDS=5

# Bounded failure thresholds
READINESS_TIMEOUT_SECONDS=5
MALFORMED_MEDIA_FRAME_LIMIT=3
TWILIO_AUDIO_QUEUE_MAX_FRAMES=100
TWILIO_OUTBOUND_QUEUE_MAX_FRAMES=200
PERSISTENCE_QUEUE_MAX_EVENTS=100
PERSISTENCE_CLEANUP_TIMEOUT_SECONDS=5
PERSISTENCE_MAX_ATTEMPTS=3
PERSISTENCE_RETRY_BASE_DELAY_SECONDS=0.1
